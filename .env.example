# Banco de dados PostgreSQL (Render fornece automaticamente)
# Exemplo: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/phishing_demo

# Chave secreta (gere uma aleatória forte)
SECRET_KEY=sua-chave-secreta-muito-forte-aqui

# Porta (Render define automaticamente)
PORT=10000

# Ambiente
FLASK_ENV=production
